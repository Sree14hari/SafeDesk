{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "safedesk",
  "version": "0.1.0",
  "identifier": "com.safedesk.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run next:dev",
    "beforeBuildCommand": "npm run next:build"
  },
  "app": {
    "windows": [
      {
        "title": "SafeDesk (SecureEngine)",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "contentProtected": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "dialog": null,
    "opener": null
  }
}
