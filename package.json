{
  "name": "safedesk",
  "version": "0.1.0",
  "private": true,
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run next:dev\" \"npm run electron:dev\"",
    "next:dev": "next dev renderer/next-app -p 3000",
    "next:build": "next build renderer/next-app",
    "next:export": "next export renderer/next-app",
    "electron:dev": "wait-on http://localhost:3000 && tsc -p electron/tsconfig.json && electron .",
    "electron:build": "tsc -p electron/tsconfig.json",
    "build": "npm run next:build && npm run electron:build",
    "start": "electron ."
  },
  "build": {
    "directories": {
      "output": "dist/installers"
    },
    "win": {
      "icon": "assets/icon.png"
    },
    "mac": {
      "icon": "assets/icon.png"
    },
    "linux": {
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@types/fs-extra": "^11.0.4",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "formidable": "^3.5.4",
    "fs-extra": "^11.3.3",
    "ip": "^2.0.1",
    "lucide-react": "^0.563.0",
    "next": "^16.1.6",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/formidable": "^3.4.6",
    "@types/ip": "^1.1.3",
    "@types/node": "^20.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "concurrently": "^8.2.2",
    "electron": "^40.1.0",
    "electron-builder": "^26.6.0",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0"
  }
}
